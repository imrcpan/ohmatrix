{
  "name": "@ohmatrix/desktop-windows",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "bundle": "react-native bundle --platform windows --dev false --entry-file index.ts --bundle-output build/index.windows.bundle --assets-dest build",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@ohmatrix/app": "workspace:*",
    "@ohmatrix/core": "workspace:*",
    "@ohmatrix/engine-mock": "workspace:*",
    "@ohmatrix/state": "workspace:*",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-svg": "15.15.4",
    "react-native-windows": "0.85.0"
  },
  "devDependencies": {
    "@react-native-community/cli": "20.1.0",
    "@react-native/babel-preset": "0.86.3",
    "@react-native/metro-config": "0.86.3",
    "@types/react": "~19.2.0"
  },
  "react-native-windows": {
    "init-windows": {
      "name": "OhMatrix",
      "namespace": "OhMatrix",
      "template": "cpp-app"
    }
  }
}
