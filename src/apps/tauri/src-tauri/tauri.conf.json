{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OhMatrix",
  "version": "0.0.0",
  "identifier": "org.ohmatrix.app",
  "build": {
    "beforeDevCommand": "pnpm --filter @ohmatrix/web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @ohmatrix/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [{ "title": "OhMatrix", "width": 1200, "height": 800, "minWidth": 360, "minHeight": 480 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "category": "SocialNetworking",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
