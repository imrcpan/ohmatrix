{
  "expo": {
    "name": "OhMatrix",
    "slug": "oh-matrix",
    "version": "0.0.0",
    "scheme": "ohmatrix",
    "orientation": "default",
    "newArchEnabled": true,
    "android": {
      "package": "org.ohmatrix.app"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "minSdkVersion": 26,
            "useLegacyPackaging": true,
            "buildArchs": ["arm64-v8a"]
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "OhMatrix uses the microphone to record voice messages."
        }
      ],
      "expo-sharing",
      "expo-notifications",
      [
        "expo-media-library",
        {
          "savePhotosPermission": "OhMatrix saves the pictures you choose to your photos.",
          "granularPermissions": ["photo"]
        }
      ],
      "./plugins/withAppIcons"
    ]
  }
}
