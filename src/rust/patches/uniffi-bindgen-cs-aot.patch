diff --git a/bindgen/src/gen_cs/filters.rs b/bindgen/src/gen_cs/filters.rs
index d8a56ef..072af40 100644
--- a/bindgen/src/gen_cs/filters.rs
+++ b/bindgen/src/gen_cs/filters.rs
@@ -257,3 +257,76 @@ pub(super) fn variant_discr_type_name(typ: &Type) -> Result<String, askama::Erro
         _ => Err(askama::Error::Fmt),
     }
 }
+
+/// The C# statements that release what `expr` (of the given type) holds, decided here from the type and not at run time: nothing for a type
+/// that holds no object, `expr.Dispose()` for an object (or a record or enum that holds one), and a loop for a list, a map or an optional that
+/// holds one. `depth` makes the names of nested loop variables differ.
+pub(super) fn dispose_stmt(
+    type_: &Type,
+    expr: &str,
+    ci: &ComponentInterface,
+) -> Result<String, askama::Error> {
+    Ok(dispose_code(type_, expr, ci, 0))
+}
+
+/// `variant_value.Field`, with `Value` added when the field has the name of its variant (as `enum_field_name` of macros.cs does).
+pub(super) fn enum_field_access(
+    field_name: &str,
+    variant_class: &str,
+) -> Result<String, askama::Error> {
+    let suffix = if field_name == variant_class { "Value" } else { "" };
+    Ok(format!("variant_value.{field_name}{suffix}"))
+}
+
+fn dispose_code(type_: &Type, expr: &str, ci: &ComponentInterface, depth: usize) -> String {
+    if !ci.item_contains_object_references(type_) {
+        return String::new();
+    }
+    match type_ {
+        // An object, and a record, enum or error that holds one, is IDisposable.
+        Type::Object { .. }
+        | Type::Record { .. }
+        | Type::Enum { .. } => format!("{expr}?.Dispose();"),
+        Type::Optional { inner_type } => {
+            let inner = dispose_code(inner_type, expr, ci, depth);
+            // A nullable value type has to be unwrapped; a reference type is tested where it is used.
+            if inner.is_empty() {
+                inner
+            } else {
+                format!("if ({expr} is not null) {{ {inner} }}")
+            }
+        }
+        Type::Sequence { inner_type } => {
+            let v = format!("item{depth}");
+            let inner = dispose_code(inner_type, &v, ci, depth + 1);
+            format!("if ({expr} is not null) {{ foreach (var {v} in {expr}) {{ {inner} }} }}")
+        }
+        Type::Map { value_type, .. } => {
+            let v = format!("value{depth}");
+            let inner = dispose_code(value_type, &v, ci, depth + 1);
+            format!("if ({expr} is not null) {{ foreach (var {v} in {expr}.Values) {{ {inner} }} }}")
+        }
+        Type::Custom { builtin, .. } => dispose_code(builtin, expr, ci, depth),
+        _ => String::new(),
+    }
+}
+
+/// The types of a native callback as a C# function pointer lists them: its arguments (a call status as a pointer, which is what `ref` is on the
+/// native side), then the return type. For `delegate* unmanaged[Cdecl]<...>`.
+pub(super) fn unmanaged_fn_types(
+    callback: &FfiCallbackFunction,
+) -> Result<String, askama::Error> {
+    let mut types: Vec<String> = callback
+        .arguments()
+        .iter()
+        .map(|a| oracle().ffi_type_label(&a.type_(), true))
+        .collect();
+    if callback.has_rust_call_status_arg() {
+        types.push("UniffiRustCallStatus*".to_string());
+    }
+    types.push(match callback.return_type() {
+        Some(t) => oracle().ffi_type_label(t, true),
+        None => "void".to_string(),
+    });
+    Ok(types.join(", "))
+}
