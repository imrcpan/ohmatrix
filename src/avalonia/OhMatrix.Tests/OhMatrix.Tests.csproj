<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RootNamespace>OhMatrix.Tests</RootNamespace>
        <TargetFramework>net11.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <OutputType>Exe</OutputType>
        <Nullable>enable</Nullable>
        <IsAotCompatible>true</IsAotCompatible>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../OhMatrix.Core/OhMatrix.Core.csproj" />
        <ProjectReference Include="../OhMatrix.Infra/OhMatrix.Infra.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.5" />
      <PackageReference Include="Avalonia.Skia" Version="12.1.5" />
      <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
      <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
      <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
      <PackageReference Include="xunit.v3" Version="3.2.2" />
    </ItemGroup>

</Project>
