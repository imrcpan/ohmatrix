<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RootNamespace>OhMatrix.Desktop</RootNamespace>
        <TargetFramework>net11.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <OutputType>Exe</OutputType>
        <Nullable>enable</Nullable>
        <IsAotCompatible>true</IsAotCompatible>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <!-- Debug runs on the JIT so that building and running stay fast; only Release is AOT. -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <PublishAot>true</PublishAot>
    </PropertyGroup>

    <!-- Signing in works where the Matrix SDK was built (src/rust/build-native.sh); elsewhere the app starts but refuses to sign in. -->
    <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)/../OhMatrix.MatrixSdk/native/bindings')">
        <DefineConstants>$(DefineConstants);OHMATRIX_NATIVE_SDK</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    </ItemGroup>

    <!-- F12 in Debug (the JIT build) opens the Avalonia developer tools (the global tool avdt); Release is AOT and does not take the package. -->
    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../OhMatrix.Core/OhMatrix.Core.csproj" />
        <ProjectReference Include="../OhMatrix.Engine/OhMatrix.Engine.csproj" />
    </ItemGroup>

</Project>
