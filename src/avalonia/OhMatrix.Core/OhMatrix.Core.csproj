<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RootNamespace>OhMatrix.Core</RootNamespace>
        <TargetFramework>net11.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <OutputType>Library</OutputType>
        <Nullable>enable</Nullable>
        <IsAotCompatible>true</IsAotCompatible>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
        <ImplicitUsings>enable</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <!-- The texts are the TOML files of src/i18n, shared with the React Native app. -->
    <ItemGroup>
        <EmbeddedResource Include="../../i18n/locales/*.toml" LogicalName="i18n/%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.5" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    </ItemGroup>

</Project>
